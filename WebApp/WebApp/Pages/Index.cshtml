@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}

<div class="text-center">
    <h1 class="display-4">Phaseolus Express</h1>
    <p>Welcome to Phaseolus Express online order service!</p>
</div>

<div class="row">
    <div class="col-sm-6">
        <div class="card text-center">
            <div class="card-body">
                <h5 class="card-title">Show Me Them Beans</h5>
                <h6 class="card-text">View our assortment of the finest beans known to man.</h6>
                <a asp-page="/Beans" class="card-link">View beans</a>
            </div>
        </div>
    </div>

    <div class="col-sm-6">
        <div class="card text-center">
            <div class="card-body">
                <h5 class="card-title">Bring Me The Cart</h5>
                <h6 class="card-text">View your cart and check out.</h6>
                <a asp-page="/Cart" class="card-link">View cart</a>
            </div>
        </div>
    </div>
</div>